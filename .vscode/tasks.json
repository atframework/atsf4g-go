{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev-Build All (Incremental)",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Dev-Build Lobbysvr Only Bin (Skip Codegen)",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "build",
        "-service",
        "lobbysvr",
        "-skip-codegen"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Dev-Build Lobbysvr Debug Race (Skip Codegen)",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "build",
        "-service",
        "lobbysvr",
        "-mode",
        "Debug",
        "-race",
        "-skip-codegen"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Dev-Generate Proto Only",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "proto"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Dev-Generate Config Only",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "config"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Dev-Run Tests",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "test"
    },
    {
      "label": "Dev-Verify Submodules Standalone",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "verify-standalone",
        "-test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "test"
    },
    {
      "label": "Dev-Lint",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "lint"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Dev-Clean Generated Code",
      "type": "shell",
      "command": "go",
      "args": [
        "tool",
        "dev",
        "clean",
        "-pb"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go",
      "group": "none"
    },
    {
      "label": "Deploy-Update Dependencies",
      "type": "shell",
      "command": "./update_dependency.sh",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/install"
      },
      "windows": {
        "command": "./update_dependency.bat"
      },
      "group": "none"
    },
    {
      "label": "Deploy-GenerateServiceConfig",
      "type": "shell",
      "command": "./generate_config.sh",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/install"
      },
      "windows": {
        "command": "./generate_config.bat"
      },
      "group": "none"
    },
    {
      "label": "Runtime-Start Lobbysvr",
      "type": "shell",
      "command": "./start_1.1.11.1.bat",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}/build/install/lobbysvr/bin"
      },
      "problemMatcher": "$go",
      "group": "none"
    }
  ]
}
